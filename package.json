  "license": "MIT",
  "type": "module",
  "homepage": "https://fire.transbulent.id",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gisrad/wildfire-watch.git"
  },
  "bugs": {
    "url": "https://github.com/gisrad/wildfire-watch/issues"
  },
  "author": "Evans Azka Fajrianshah",
  "keywords": [
    "wildfire",
    "indonesia",
    "karhutla",
    "peatland",
    "nasa-firms",
    "viirs",
    "remote-sensing",
    "maplibre-gl",
    "gis",
    "cloudflare-workers",
    "cloudflare-d1",
    "astro"
  ],
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4324",
